+    // OGX-Mini: a bonded controller coming back advertises without an appearance:
+    // directed advertising with no data, or undirected advertising that is not
+    // discoverable (Steam Controller 2). Reconnect to it as a gamepad; the parser
+    // is still picked from its VID/PID once connected.
+    {
+        uint8_t event_type = gap_event_advertising_report_get_advertising_event_type(packet);
+        bd_addr_type_t adv_addr_type = (bd_addr_type_t)gap_event_advertising_report_get_address_type(packet);
+        if (appearance == 0 && (event_type == 0 /* ADV_IND */ || event_type == 1 /* ADV_DIRECT_IND */) &&
+            is_bonded_le_address(adv_addr_type, addr)) {
+            logi("Bonded device %s advertising, reconnecting\n", bd_addr_to_str(addr));
+            appearance = UNI_BT_HID_APPEARANCE_GAMEPAD;
+        }
+    }
+
     if (appearance != UNI_BT_HID_APPEARANCE_GAMEPAD && appearance != UNI_BT_HID_APPEARANCE_JOYSTICK &&
         appearance != UNI_BT_HID_APPEARANCE_MOUSE && appearance != UNI_BT_HID_APPEARANCE_KEYBOARD) {
