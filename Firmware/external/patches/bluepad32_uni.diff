+//OGX-Mini: sees every advertising report first, the capture build logs them.
+extern void ogxm_adv_report_hook(const uint8_t* packet);
+
+//OGX-Mini: true when addr is a bonded LE device.
+static bool is_bonded_le_address(bd_addr_type_t addr_type, const bd_addr_t addr) {
+    for (int i = 0; i < le_device_db_max_count(); i++) {
+        int entry_type = (int)BD_ADDR_TYPE_UNKNOWN;
+        bd_addr_t entry_addr;
+        le_device_db_info(i, &entry_type, entry_addr, NULL);
+        if (entry_type == (int)addr_type && memcmp(entry_addr, addr, BD_ADDR_LEN) == 0)
+            return true;
+    }
+    return false;
+}
