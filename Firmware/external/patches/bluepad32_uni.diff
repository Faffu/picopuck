+//OGX-Mini: haptic rumble over the report characteristic.
+//The payload mirrors hid-steam's STEAM_CMD_HAPTIC_RUMBLE. UNVERIFIED on the
+//Steam Controller 2, confirm the gain/intensity ranges against real hardware.
+void uni_hid_parser_steam_play_dual_rumble(struct uni_hid_device_s* d,
+                                           uint16_t duration_ms,
+                                           uint8_t amplitude_left,
+                                           uint8_t amplitude_right) {
+    ARG_UNUSED(duration_ms);
+
+    if (d != device || le_steam_characteristic_report.value_handle == 0)
+        return;
+
+    uint16_t intensity_l = (uint16_t)amplitude_left << 7;
+    uint16_t intensity_r = (uint16_t)amplitude_right << 7;
+
+    uint8_t cmd[] = {
+        0xc0, STEAM_CMD_HAPTIC_RUMBLE, 0x09,
+        intensity_l & 0xff, intensity_l >> 8,
+        intensity_r & 0xff, intensity_r >> 8,
+        0x00, 0x00,
+        amplitude_left, amplitude_right,
+    };
+
+    gatt_client_write_value_of_characteristic_without_response(
+        connection_handle, le_steam_characteristic_report.value_handle, sizeof(cmd), cmd);
+}
